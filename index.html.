<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#6d5efc">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Mes Tâches">
  <link rel="manifest" href="manifest.json">
  <link rel="icon" href="icon.svg" type="image/svg+xml">
  <title>Mes Tâches</title>

  <style>
    /* ====== Couleurs et réglages de base ====== */
    :root {
      --bg: #f4f5fb;
      --card: #ffffff;
      --text: #1e2233;
      --muted: #8a8fa3;
      --primary: #6d5efc;
      --primary-dark: #5a4be0;
      --danger: #ff5c72;
      --border: #e8eaf3;
      --shadow: 0 10px 30px rgba(30, 34, 51, .08);
    }

    /* Mode sombre automatique si le téléphone est en sombre */
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #12141d;
        --card: #1b1e2b;
        --text: #f2f3f8;
        --muted: #8b90a8;
        --border: #262a3a;
        --shadow: 0 10px 30px rgba(0, 0, 0, .4);
      }
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      padding: 16px;
      padding-top: max(16px, env(safe-area-inset-top));
    }

    .app {
      width: 100%;
      max-width: 520px;
    }

    /* ====== En-tête ====== */
    header {
      background: linear-gradient(135deg, var(--primary), #9a6bff);
      color: #fff;
      border-radius: 22px;
      padding: 22px;
      box-shadow: var(--shadow);
      margin-bottom: 16px;
    }

    header h1 {
      margin: 0 0 4px;
      font-size: 1.5rem;
      letter-spacing: -.02em;
    }

    header .date {
      font-size: .85rem;
      opacity: .85;
      text-transform: capitalize;
    }

    header .count {
      margin-top: 14px;
      display: inline-block;
      background: rgba(255, 255, 255, .18);
      padding: 6px 12px;
      border-radius: 999px;
      font-size: .85rem;
      font-weight: 600;
    }

    /* ====== Formulaire d'ajout ====== */
    form {
      display: flex;
      gap: 10px;
      margin-bottom: 14px;
    }

    #input {
      flex: 1;
      border: 2px solid var(--border);
      background: var(--card);
      color: var(--text);
      border-radius: 16px;
      padding: 14px 16px;
      font-size: 1rem;
      outline: none;
      transition: border-color .2s;
    }

    #input:focus {
      border-color: var(--primary);
    }

    form button {
      flex: 0 0 auto;
      width: 54px;
      height: 54px;
      border: none;
      border-radius: 16px;
      background: var(--primary);
      color: #fff;
      font-size: 1.6rem;
      line-height: 1;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(109, 94, 252, .35);
      transition: transform .1s, background .2s;
    }

    form button:active {
      transform: scale(.94);
      background: var(--primary-dark);
    }

    /* ====== Filtres ====== */
    .filters {
      display: flex;
      gap: 8px;
      margin-bottom: 14px;
    }

    .filters button {
      flex: 1;
      border: 2px solid var(--border);
      background: var(--card);
      color: var(--muted);
      padding: 10px;
      border-radius: 12px;
      font-size: .85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all .2s;
    }

    .filters button.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff;
    }

    /* ====== Liste des tâches ====== */
    ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .task {
      display: flex;
      align-items: center;
      gap: 12px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 14px 16px;
      box-shadow: var(--shadow);
      animation: pop .18s ease;
    }

    @keyframes pop {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .check {
      flex: 0 0 auto;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      border: 2px solid var(--border);
      background: transparent;
      color: #fff;
      font-size: .9rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all .2s;
    }

    .task.done .check {
      background: var(--primary);
      border-color: var(--primary);
    }

    .text {
      flex: 1;
      font-size: 1rem;
      word-break: break-word;
      transition: color .2s;
    }

    .task.done .text {
      color: var(--muted);
      text-decoration: line-through;
    }

    .del {
      flex: 0 0 auto;
      border: none;
      background: transparent;
      color: var(--muted);
      font-size: 1.1rem;
      cursor: pointer;
      padding: 6px;
      border-radius: 8px;
      transition: color .2s, background .2s;
    }

    .del:active {
      color: var(--danger);
      background: rgba(255, 92, 114, .12);
    }

    /* ====== Message liste vide ====== */
    #empty {
      text-align: center;
      color: var(--muted);
      font-size: .95rem;
      padding: 40px 10px;
      display: none;
    }

    #empty .emoji {
      display: block;
      font-size: 2.4rem;
      margin-bottom: 8px;
    }

    /* ====== Pied de page ====== */
    footer {
      margin-top: 18px;
      text-align: center;
    }

    #clear {
      border: none;
      background: transparent;
      color: var(--muted);
      font-size: .85rem;
      cursor: pointer;
      padding: 8px 14px;
      border-radius: 10px;
      transition: color .2s, background .2s;
    }

    #clear:active {
      color: var(--danger);
      background: rgba(255, 92, 114, .12);
    }
  </style>
</head>

<body>
  <div class="app">

    <!-- En-tête -->
    <header>
      <h1>Mes Tâches</h1>
      <div class="date" id="today"></div>
      <div class="count" id="count">0 tâche restante</div>
    </header>

    <!-- Ajout d'une tâche -->
    <form id="form" autocomplete="off">
      <input id="input" type="text" placeholder="Que dois-tu faire ?" maxlength="120" aria-label="Nouvelle tâche">
      <button type="submit" aria-label="Ajouter">+</button>
    </form>

    <!-- Filtres -->
    <div class="filters">
      <button data-filter="all" class="active">Toutes</button>
      <button data-filter="active">À faire</button>
      <button data-filter="done">Terminées</button>
    </div>

    <!-- Liste -->
    <ul id="list"></ul>

    <p id="empty">
      <span class="emoji">🌿</span>
      Aucune tâche ici pour le moment.
    </p>

    <!-- Pied de page -->
    <footer>
      <button id="clear">Effacer les tâches terminées</button>
    </footer>

  </div>

  <script>
    // ==================================================
    //  Application "Mes Tâches"
    //  Tout le code est commenté pour que tu apprennes.
    // ==================================================

    // Clé utilisée pour sauvegarder les tâches sur le téléphone.
    const STORAGE_KEY = 'mes-taches-v1';

    // On récupère les tâches sauvegardées (ou une liste vide).
    let tasks = loadTasks();

    // Filtre actif : "all", "active" ou "done".
    let currentFilter = 'all';

    // Raccourcis vers les éléments de la page.
    const form       = document.getElementById('form');
    const input      = document.getElementById('input');
    const list       = document.getElementById('list');
    const empty      = document.getElementById('empty');
    const count      = document.getElementById('count');
    const clearBtn   = document.getElementById('clear');
    const todayEl    = document.getElementById('today');
    const filterBtns = document.querySelectorAll('[data-filter]');

    // ---------- Sauvegarde / chargement ----------

    function loadTasks() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        return saved ? JSON.parse(saved) : [];
      } catch (e) {
        // Si la sauvegarde est corrompue, on repart de zéro.
        return [];
      }
    }

    function saveTasks() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(tasks));
    }

    // ---------- Actions ----------

    function addTask(text) {
      tasks.unshift({
        id: Date.now().toString(),
        text: text,
        done: false
      });
      saveTasks();
      render();
    }

    function toggleTask(id) {
      const task = tasks.find(t => t.id === id);
      if (task) {
        task.done = !task.done;
        saveTasks();
        render();
      }
    }

    function deleteTask(id) {
      tasks = tasks.filter(t => t.id !== id);
      saveTasks();
      render();
    }

    function clearDone() {
      tasks = tasks.filter(t => !t.done);
      saveTasks();
      render();
    }

    // ---------- Affichage ----------

    function render() {
      // 1. On choisit les tâches à afficher selon le filtre.
      const visible = tasks.filter(t => {
        if (currentFilter === 'active') return !t.done;
        if (currentFilter === 'done')   return t.done;
        return true; // "all"
      });

      // 2. On vide la liste puis on la reconstruit.
      list.innerHTML = '';

      visible.forEach(task => {
        const li = document.createElement('li');
        li.className = 'task' + (task.done ? ' done' : '');

        // On crée les boutons et le texte séparément
        // (évite les problèmes de sécurité avec innerHTML).
        const checkBtn = document.createElement('button');
        checkBtn.className = 'check';
        checkBtn.textContent = task.done ? '✓' : '';
        checkBtn.setAttribute('aria-label', 'Marquer comme terminée');
        checkBtn.addEventListener('click', () => toggleTask(task.id));

        const span = document.createElement('span');
        span.className = 'text';
        span.textContent = task.text;

        const delBtn = document.createElement('button');
        delBtn.className = 'del';
        delBtn.textContent = '✕';
        delBtn.setAttribute('aria-label', 'Supprimer la tâche');
        delBtn.addEventListener('click', () => deleteTask(task.id));

        li.append(checkBtn, span, delBtn);
        list.appendChild(li);
      });

      // 3. Message si la liste visible est vide.
      empty.style.display = visible.length === 0 ? 'block' : 'none';

      // 4. Compteur de tâches restantes.
      const remaining = tasks.filter(t => !t.done).length;
      count.textContent = remaining + (remaining > 1 ? ' tâches restantes' : ' tâche restante');

      // 5. Bouton "effacer" seulement s'il y a des tâches terminées.
      clearBtn.style.display = tasks.some(t => t.done) ? 'inline-block' : 'none';
    }

    // ---------- Événements ----------

    // Ajouter une tâche quand on valide le formulaire.
    form.addEventListener('submit', event => {
      event.preventDefault();
      const text = input.value.trim();
      if (!text) return;
      addTask(text);
      input.value = '';
      input.focus();
    });

    // Changer de filtre.
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentFilter = btn.dataset.filter;
        filterBtns.forEach(b => b.classList.toggle('active', b === btn));
        render();
      });
    });

    // Effacer les tâches terminées.
    clearBtn.addEventListener('click', clearDone);

    // ---------- Démarrage ----------

    // Affiche la date du jour en français.
    todayEl.textContent = new Date().toLocaleDateString('fr-FR', {
      weekday: 'long',
      day: 'numeric',
      month: 'long'
    });

    // Premier affichage.
    render();

    // Active le mode "hors-ligne / installable" (seulement si le site est hébergé).
    if ('serviceWorker' in navigator && location.protocol.startsWith('http')) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('sw.js').catch(() => {});
      });
    }
  </script>
</body>
</html>
